---
/** Simple line icons for the contact channel rows (stroke="currentColor"). */
export type ContactIconName = 'email' | 'whatsapp' | 'linkedin' | 'github' | 'cv';

interface Props {
  name: ContactIconName;
}

const { name } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'email' && (
      <Fragment>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m3 7 9 6 9-6" />
      </Fragment>
    )
  }
  {
    name === 'whatsapp' && (
      <Fragment>
        <path d="M20 11.5a8 8 0 0 1-11.8 7L4 20l1.5-4.1A8 8 0 1 1 20 11.5z" />
        <path d="M9 9.5c0 3 2.5 5.5 5.5 5.5" />
      </Fragment>
    )
  }
  {
    name === 'linkedin' && (
      <Fragment>
        <rect x="3" y="3" width="18" height="18" rx="3" />
        <path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7" />
      </Fragment>
    )
  }
  {
    name === 'github' && (
      <path d="M9 19c-4 1.5-4-2-6-2.5M15 21v-3.5a3 3 0 0 0-.8-2.3c2.7-.3 5.5-1.3 5.5-6a4.7 4.7 0 0 0-1.3-3.2 4.4 4.4 0 0 0-.1-3.2s-1-.3-3.4 1.3a11.6 11.6 0 0 0-6 0C6.5 2.5 5.5 2.8 5.5 2.8a4.4 4.4 0 0 0-.1 3.2A4.7 4.7 0 0 0 4 9.2c0 4.7 2.8 5.7 5.5 6a3 3 0 0 0-.8 2.3V21" />
    )
  }
  {
    name === 'cv' && (
      <Fragment>
        <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
        <path d="M14 3v5h5M12 11v6M9 14l3 3 3-3" />
      </Fragment>
    )
  }
</svg>

<style>
  svg {
    width: 20px;
    height: 20px;
  }
</style>
