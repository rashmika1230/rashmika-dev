---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.webp';
import { profile } from '../data/profile';
import SectionHead from './SectionHead.astro';

const { about } = profile;
---

<section class="band inv" id="about" aria-labelledby="about-title">
  <div class="wrap">
    <SectionHead id="about-title" title={about.title} accent={about.accent} intro={about.intro} />
    <div class="about">
      <figure class="portrait reveal">
        <Image
          src={portrait}
          alt={about.portrait.alt}
          widths={[380, 520, 760]}
          sizes="(max-width: 860px) min(420px, calc(100vw - 32px)), 34vw"
          loading="eager"
        />
        <figcaption><i aria-hidden="true"></i>{about.portrait.caption}</figcaption>
      </figure>
      <div class="copy">
        <p class="big reveal">
          {about.statement.before}<em>{about.statement.emphasis}</em>{about.statement.after}
        </p>
        <dl class="facts reveal">
          {
            about.facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.3fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }

  .copy {
    display: grid;
    gap: clamp(28px, 4vw, 48px);
  }

  .portrait {
    position: relative;
    margin: 0;
    border-radius: 18px;
    overflow: hidden;
    background: #1a1a1a;
    aspect-ratio: 4 / 5;
  }

  /* <Image> renders from a child component, so target it with :global(). */
  .portrait :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .portrait:hover :global(img) {
    transform: scale(1.03);
  }

  figcaption {
    position: absolute;
    left: 14px;
    bottom: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--w);
    background: rgba(10, 10, 10, 0.6);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    padding: 6px 12px;
    border-radius: 99px;
  }

  figcaption i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  .big {
    font-size: clamp(22px, 2.6vw, 32px);
    line-height: 1.3;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .facts {
    display: grid;
    gap: 0;
    margin: 0;
    border-top: 1px solid var(--line);
  }

  .facts div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }

  dt {
    color: var(--g);
  }

  dd {
    margin: 0;
    font-weight: 600;
    text-align: right;
  }

  @media (max-width: 860px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
    }

    .portrait {
      max-width: 420px;
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .portrait:hover :global(img) {
      transform: none;
    }
  }
</style>
