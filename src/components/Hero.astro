---
import { profile } from '../data/profile';
import HeroDiagram from './HeroDiagram.astro';

const { hero } = profile;
---

<header class="band" id="top">
  <div class="wrap hero">
    <div>
      <span class="status"><i aria-hidden="true"></i>{hero.status}</span>
      <h1>{profile.firstName}<br /><em>{profile.lastName}</em></h1>
      <p class="lead">{hero.lead}</p>
      <div class="btns">
        <a class="btn solid" href={hero.primaryCta.href}>{hero.primaryCta.label}</a>
        <a class="btn" href={hero.secondaryCta.href}>{hero.secondaryCta.label}</a>
      </div>
    </div>
    <HeroDiagram />
  </div>
</header>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
    min-height: calc(100vh - 64px);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--g);
    border: 1px solid var(--line);
    padding: 8px 14px;
    border-radius: 99px;
  }

  .status i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 25%, transparent);
  }

  h1 {
    font-size: clamp(52px, 9vw, 128px);
    line-height: 0.92;
    letter-spacing: -0.045em;
    font-weight: 800;
    margin: 28px 0 24px;
    text-wrap: balance;
  }

  h1 em {
    font-size: 1.04em;
    letter-spacing: -0.02em;
  }

  .lead {
    font-size: clamp(17px, 1.6vw, 20px);
    color: #cfcfcf;
    max-width: 34em;
    margin: 0 0 32px;
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
    }
  }
</style>
