---
import { skills, skillsSection } from '../data/skills';
import SectionHead from './SectionHead.astro';
---

<section class="band" id="skills" aria-labelledby="skills-title">
  <div class="wrap">
    <SectionHead id="skills-title" {...skillsSection} />
    <div class="skills">
      {
        skills.map((group) => (
          <div class="skill reveal">
            <h3>{group.title}</h3>
            <p>{group.description}</p>
            <ul class="tags" aria-label={`${group.title} skills`}>
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .skills {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .skill {
    padding: 28px 24px 32px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    transition: background 0.25s, color 0.25s;
  }

  .skill:hover {
    background: var(--w);
    color: var(--k);
  }

  h3 {
    font-size: 22px;
    margin: 0 0 6px;
    letter-spacing: -0.02em;
  }

  p {
    margin: 0 0 18px;
    color: var(--g);
    font-size: 15px;
  }

  .skill:hover p {
    color: #555;
  }

  @media (max-width: 980px) {
    .skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .skills {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
