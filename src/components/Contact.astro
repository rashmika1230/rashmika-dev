---
import { profile } from '../data/profile';
import { withBase } from '../utils/url';
import ContactIcon from './ContactIcon.astro';

const { contact, links, email, whatsapp } = profile;
const { form } = contact;

type IconName = 'email' | 'whatsapp' | 'linkedin' | 'github' | 'cv';

interface Channel {
  icon: IconName;
  label: string;
  detail: string;
  href: string;
  go: string;
  download?: boolean;
  rel?: string;
}

const channels: Channel[] = [
  { icon: 'email', label: contact.channels.email.label, detail: email, href: `mailto:${email}`, go: '↗' },
  // Hidden until profile.whatsapp.number is filled in.
  ...(whatsapp.number
    ? [
        {
          icon: 'whatsapp' as const,
          label: contact.channels.whatsapp.label,
          detail: whatsapp.display || `+${whatsapp.number}`,
          href: `https://wa.me/${whatsapp.number}`,
          go: '↗',
        },
      ]
    : []),
  { icon: 'linkedin', ...contact.channels.linkedin, href: links.linkedin, go: '↗', rel: 'me' },
  { icon: 'github', ...contact.channels.github, href: links.github, go: '↗', rel: 'me' },
  { icon: 'cv', ...contact.channels.cv, href: withBase(links.cv), go: '↓', download: true },
];

// Text the form script needs at runtime (all content stays in profile.ts).
const formConfig = {
  email,
  subject: form.subject,
  sending: form.sending,
  failure: form.failure,
  errors: { name: form.name.error, email: form.email.error, message: form.message.error },
};
---

<section class="band inv" id="contact" aria-labelledby="contact-title">
  <div class="wrap contact">
    <div>
      <h2 id="contact-title">{contact.before}<em>{contact.accent}</em><br />{contact.after}</h2>
      <p class="intro">{contact.intro}</p>
      <div class="channels">
        {
          channels.map((ch) => (
            <a class="ch" href={ch.href} rel={ch.rel} download={ch.download}>
              <span class="ic">
                <ContactIcon name={ch.icon} />
              </span>
              <span>
                <b>{ch.label}</b>
                <small>{ch.detail}</small>
              </span>
              <span class="go" aria-hidden="true">
                {ch.go}
              </span>
            </a>
          ))
        }
      </div>
      <p class="reply"><i aria-hidden="true"></i>{contact.reply}</p>
    </div>

    <form class="form" novalidate data-contact-form data-config={JSON.stringify(formConfig)} aria-labelledby="form-title">
      <h3 id="form-title">{form.title} <em>{form.titleAccent}</em></h3>

      <fieldset class="topics">
        <legend>{form.topicsLegend}</legend>
        {
          form.topics.map((topic, i) => (
            <label>
              <input type="radio" name="topic" value={topic} checked={i === 0} />
              <span>{topic}</span>
            </label>
          ))
        }
      </fieldset>

      <div class="row">
        <div class="field">
          <label for="f-name">{form.name.label}</label>
          <input
            id="f-name"
            name="name"
            autocomplete="name"
            placeholder={form.name.placeholder}
            required
            aria-describedby="f-name-err"
          />
          <span class="err" id="f-name-err"></span>
        </div>
        <div class="field">
          <label for="f-email">{form.email.label}</label>
          <input
            id="f-email"
            name="email"
            type="email"
            autocomplete="email"
            placeholder={form.email.placeholder}
            required
            aria-describedby="f-email-err"
          />
          <span class="err" id="f-email-err"></span>
        </div>
      </div>

      <div class="field">
        <label for="f-msg">{form.message.label}</label>
        <textarea
          id="f-msg"
          name="message"
          placeholder={form.message.placeholder}
          required
          aria-describedby="f-msg-err"></textarea>
        <span class="err" id="f-msg-err"></span>
      </div>

      <!-- Honeypot for Web3Forms spam filtering: hidden from people, bots tick it. -->
      <input class="hp" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="send">
        <small>{form.note}</small>
        <button class="btn" type="submit" data-submit>{form.submit}</button>
      </div>
      <p class="status" role="status" aria-live="polite" data-status></p>

      <div class="done">
        <div class="tick" aria-hidden="true">✓</div>
        <h3 tabindex="-1" data-done-title>{form.done.title} <em>{form.done.titleAccent}</em></h3>
        <p>{form.done.text}</p>
        <button class="btn" type="button" data-again>{form.done.again}</button>
      </div>
    </form>
  </div>
</section>

<script>
  /**
   * Contact form → Web3Forms (https://web3forms.com), so it works on static GitHub Pages.
   * The access key comes from PUBLIC_WEB3FORMS_KEY at build time. Success is only shown
   * when the API answers { success: true }; anything else shows an error with the email fallback.
   */
  const ENDPOINT = 'https://api.web3forms.com/submit';
  const ACCESS_KEY = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';

  interface FormConfig {
    email: string;
    subject: string;
    sending: string;
    failure: string;
    errors: { name: string; email: string; message: string };
  }

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    const config = JSON.parse(form.dataset.config ?? '{}') as FormConfig;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const doneTitle = form.querySelector<HTMLElement>('[data-done-title]')!;
    const again = form.querySelector<HTMLButtonElement>('[data-again]')!;
    const submitLabel = submit.textContent ?? '';

    const nameEl = form.elements.namedItem('name') as HTMLInputElement;
    const emailEl = form.elements.namedItem('email') as HTMLInputElement;
    const messageEl = form.elements.namedItem('message') as HTMLTextAreaElement;
    const botcheck = form.elements.namedItem('botcheck') as HTMLInputElement;

    const rules: [HTMLInputElement | HTMLTextAreaElement, () => boolean, string][] = [
      [nameEl, () => nameEl.value.trim().length > 1, config.errors.name],
      [emailEl, () => /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(emailEl.value.trim()), config.errors.email],
      [messageEl, () => messageEl.value.trim().length > 9, config.errors.message],
    ];

    const check = (el: HTMLInputElement | HTMLTextAreaElement, ok: boolean, msg: string) => {
      const field = el.closest('.field')!;
      field.classList.toggle('bad', !ok);
      el.setAttribute('aria-invalid', String(!ok));
      field.querySelector('.err')!.textContent = ok ? '' : msg;
      return ok;
    };

    // Once a field has shown an error, clear it as soon as the input becomes valid.
    rules.forEach(([el, valid, msg]) =>
      el.addEventListener('input', () => {
        if (el.closest('.field')!.classList.contains('bad')) check(el, valid(), msg);
      }),
    );

    let busy = false;
    const setSending = (on: boolean) => {
      busy = on;
      submit.disabled = on;
      submit.textContent = on ? config.sending : submitLabel;
      form.toggleAttribute('aria-busy', on);
      status.className = on ? 'status sr-only' : 'status';
      status.textContent = on ? config.sending : '';
    };

    const showError = () => {
      status.className = 'status error';
      status.textContent = `${config.failure} `;
      const link = document.createElement('a');
      link.href = `mailto:${config.email}`;
      link.textContent = config.email;
      status.append(link, '.');
    };

    const showSuccess = () => {
      form.classList.add('sent');
      doneTitle.focus();
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (busy) return;

      const ok = rules.map(([el, valid, msg]) => check(el, valid(), msg)).every(Boolean);
      if (!ok) {
        form.querySelector<HTMLElement>('.bad input, .bad textarea')?.focus();
        return;
      }

      if (!ACCESS_KEY) {
        console.warn('Contact form: PUBLIC_WEB3FORMS_KEY is not set, so messages cannot be sent.');
        showError();
        return;
      }

      const topic = (form.elements.namedItem('topic') as RadioNodeList).value;
      const name = nameEl.value.trim();

      setSending(true);
      try {
        const response = await fetch(ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            access_key: ACCESS_KEY,
            subject: config.subject.replace('{topic}', topic),
            from_name: name,
            name,
            email: emailEl.value.trim(),
            topic,
            message: messageEl.value.trim(),
            botcheck: botcheck.checked,
          }),
        });
        const result: unknown = await response.json().catch(() => null);
        const succeeded =
          typeof result === 'object' && result !== null && (result as { success?: unknown }).success === true;

        setSending(false);
        if (succeeded) showSuccess();
        else showError();
      } catch {
        setSending(false);
        showError();
      }
    });

    again.addEventListener('click', () => {
      form.reset();
      rules.forEach(([el, , msg]) => check(el, true, msg));
      status.className = 'status';
      status.textContent = '';
      form.classList.remove('sent');
      nameEl.focus();
    });
  }
</script>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(36px, 6vw, 96px);
    align-items: start;
  }

  .contact h2 {
    font-size: clamp(48px, 7.5vw, 104px);
    line-height: 0.92;
    letter-spacing: -0.05em;
    margin: 0 0 20px;
  }

  .intro {
    color: var(--g);
    font-size: 17px;
    max-width: 30em;
    margin: 0 0 32px;
  }

  /* Channel rows */
  .channels {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .ch {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px;
    padding: 16px 4px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition: padding 0.3s;
  }

  .ch:hover {
    padding-inline: 12px;
  }

  .ic {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line);
    display: grid;
    place-items: center;
    transition: background 0.25s, color 0.25s, border-color 0.25s;
  }

  .ch:hover .ic,
  .ch:focus-visible .ic {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--k);
  }

  .ch b {
    display: block;
    font-size: 17px;
    letter-spacing: -0.01em;
  }

  .ch small {
    display: block;
    color: var(--g);
    font-size: 14px;
    overflow-wrap: anywhere;
  }

  .go {
    color: var(--g);
    font-size: 18px;
  }

  .ch:focus-visible {
    outline: 2px solid var(--k);
    outline-offset: 2px;
  }

  .reply {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 22px 0 0;
    color: var(--g);
    font-size: 14px;
  }

  .reply i {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* Message form card */
  .form {
    background: var(--k);
    color: var(--w);
    border-radius: 24px;
    padding: clamp(24px, 3.5vw, 44px);
    display: grid;
    gap: 18px;
  }

  .form h3 {
    margin: 0;
    font-size: clamp(24px, 2.6vw, 32px);
    letter-spacing: -0.03em;
  }

  .form h3 em {
    font-weight: 400;
  }

  .form h3:focus {
    outline: none;
  }

  .row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .field {
    display: grid;
    gap: 8px;
  }

  .field label {
    font-size: 14px;
    color: #cfcfcf;
  }

  .field input,
  .field textarea {
    width: 100%;
    font: 16px/1.5 var(--font-sans);
    color: var(--w);
    background: #151515;
    border: 1px solid #2c2c2c;
    border-radius: 12px;
    padding: 13px 16px;
    min-height: 48px;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .field textarea {
    min-height: 150px;
    resize: vertical;
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: #6f6f6f;
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 25%, transparent);
  }

  .field.bad input,
  .field.bad textarea {
    border-color: #ff6b6b;
  }

  .err {
    font-size: 13px;
    color: #ff8a8a;
    min-height: 0;
  }

  /* Topic chips (radio buttons) */
  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    border: 0;
    padding: 0;
    margin: 0;
  }

  .topics legend {
    font-size: 14px;
    color: #cfcfcf;
    margin-bottom: 8px;
    padding: 0;
  }

  .topics label {
    position: relative;
    cursor: pointer;
  }

  .topics input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .topics span {
    display: inline-flex;
    align-items: center;
    /* 44px touch target (the reference uses 40px). */
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid #3a3a3a;
    border-radius: 99px;
    font-size: 14px;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }

  .topics input:checked + span {
    background: var(--w);
    color: var(--k);
    border-color: var(--w);
  }

  .topics input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .hp {
    display: none;
  }

  .send {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .send small {
    color: #8a8a8a;
    font-size: 13px;
  }

  /* Higher specificity than the white-band .inv .btn rules in global.css. */
  .contact .form .btn {
    border-color: var(--w);
    background: var(--w);
    color: var(--k);
    cursor: pointer;
    font-family: inherit;
  }

  .contact .form .btn:hover:not(:disabled) {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--k);
  }

  .contact .form .btn:focus-visible {
    outline: 2px solid var(--w);
    outline-offset: 3px;
  }

  .contact .form .btn:disabled {
    opacity: 0.7;
    cursor: progress;
    transform: none;
  }

  .status {
    margin: 0;
    font-size: 14px;
    color: #cfcfcf;
  }

  .status:empty {
    display: none;
  }

  .status.error {
    color: #ff8a8a;
  }

  .status :global(a) {
    color: var(--w);
    overflow-wrap: anywhere;
  }

  /* Success state */
  .done {
    display: none;
    text-align: center;
    padding: 40px 10px;
    gap: 14px;
  }

  .tick {
    width: 64px;
    height: 64px;
    margin: 0 auto;
    border-radius: 50%;
    background: var(--accent);
    color: var(--k);
    display: grid;
    place-items: center;
    font-size: 28px;
  }

  .done p {
    margin: 0;
    color: #cfcfcf;
  }

  .done .btn {
    justify-self: center;
  }

  .form.sent > :not(.done) {
    display: none;
  }

  .form.sent .done {
    display: grid;
  }

  @media (max-width: 860px) {
    .contact {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 600px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
