---
/**
 * Animated architecture sheet: Git → CI → Docker → AWS, serving a gateway
 * with order and product services backed by MySQL. The dashed "flow" lines
 * animate unless the visitor prefers reduced motion.
 */
import { profile } from '../data/profile';

const { label, caption } = profile.hero.diagram;
---

<figure class="sheet reveal">
  <svg
    viewBox="0 0 520 448"
    fill="none"
    font-family="Inter Tight, sans-serif"
    font-size="13"
    role="img"
    aria-labelledby="hero-diagram-title"
  >
    <title id="hero-diagram-title">{label}</title>
    <g class="accent-stroke" stroke-opacity=".9" stroke-width="1.6">
      <path class="flow" d="M110 64H200"></path><path class="flow" d="M290 64H380"></path><path class="flow" d="M425 86V150"></path>
      <path class="flow" d="M380 180H300"></path><path class="flow" d="M210 180H160V250"></path><path class="flow" d="M255 202V250"></path><path class="flow" d="M300 180H350V250"></path>
      <path class="flow" d="M160 300V360H230"></path><path class="flow" d="M350 300V360H290"></path>
    </g>
    <g id="nodes" fill="#0a0a0a" stroke="#fafafa" stroke-width="1.4">
      <rect x="30" y="42" width="80" height="44" rx="10"></rect><rect x="200" y="42" width="90" height="44" rx="10"></rect><rect x="380" y="42" width="90" height="44" rx="10"></rect>
      <rect x="380" y="150" width="90" height="60" rx="10" fill="#fafafa"></rect>
      <rect x="210" y="158" width="90" height="44" rx="22"></rect>
      <rect x="105" y="250" width="110" height="50" rx="10"></rect><rect x="295" y="250" width="110" height="50" rx="10"></rect>
      <rect x="200" y="250" width="110" height="50" rx="10" opacity="0"></rect>
      <ellipse cx="260" cy="348" rx="30" ry="9"></ellipse><path d="M230 348v26c0 5 13 9 30 9s30-4 30-9v-26"></path><ellipse cx="260" cy="348" rx="30" ry="9"></ellipse>
    </g>
    <g fill="#fafafa" text-anchor="middle" aria-hidden="true">
      <text x="70" y="69">Git</text><text x="245" y="69">CI · Actions</text><text x="425" y="69">Docker</text>
      <text x="425" y="178" fill="#0a0a0a" font-weight="700">AWS</text><text x="425" y="196" fill="#0a0a0a" font-size="11">EC2 · K8s</text>
      <text x="255" y="185">Gateway</text>
      <text x="160" y="280">Order service</text><text x="350" y="280">Product service</text>
      <text x="260" y="408" fill-opacity=".6">MySQL</text>
    </g>
    <g fill="#fafafa" fill-opacity=".45" font-size="11" aria-hidden="true">
      <text x="30" y="28">build &amp; deliver</text><text x="30" y="236">serve</text>
    </g>
  </svg>
  <figcaption class="cap">{caption}</figcaption>
</figure>

<style>
  .sheet {
    position: relative;
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 20px;
    aspect-ratio: 1 / 0.86;
    background:
      radial-gradient(circle at 70% 20%, rgba(255, 255, 255, 0.07), transparent 55%),
      repeating-linear-gradient(0deg, transparent 0 31px, rgba(255, 255, 255, 0.04) 31px 32px),
      repeating-linear-gradient(90deg, transparent 0 31px, rgba(255, 255, 255, 0.04) 31px 32px);
  }

  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .cap {
    position: absolute;
    left: 18px;
    bottom: 14px;
    font-size: 13px;
    color: var(--g);
  }

  .accent-stroke {
    stroke: var(--accent);
  }

  .flow {
    stroke-dasharray: 6 8;
    animation: flow 1.6s linear infinite;
  }

  @keyframes flow {
    to {
      stroke-dashoffset: -28;
    }
  }

  /* Narrow screens: the caption wraps to two lines, so move it below the drawing
     instead of letting it overlap the MySQL node. */
  @media (max-width: 600px) {
    .sheet {
      aspect-ratio: auto;
    }

    svg {
      position: relative;
      display: block;
      height: auto;
      aspect-ratio: 520 / 448;
    }

    .cap {
      position: static;
      display: block;
      padding: 0 18px 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow {
      animation: none;
    }
  }
</style>
